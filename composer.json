{
  "name": "otisz/viktoriakupa",
  "type": "project",
  "description": "Viktória Kupa website on Bedrock WordPress",
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.3",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.0",
    "wpackagist-plugin/advanced-custom-fields": "^6.8",
    "wpackagist-plugin/wordpress-seo": "^28.6"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "install-site": "bin/install-site",
    "seed": "wp eval-file tests/Seed/seed.php",
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": [
      "@seed",
      "pest"
    ]
  }
}
