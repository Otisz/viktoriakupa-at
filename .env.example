DB_NAME='viktoriakupa'
DB_USER='viktoriakupa'
DB_PASSWORD='secret'
DB_ROOT_PASSWORD='root'
DB_HOST='mysql'

WP_ENV='development'
WP_HOME='http://localhost:8080'
WP_SITEURL="${WP_HOME}/wp"

# Host ports published by Docker Compose
APP_PORT=8080
MAILPIT_PORT=8025

# Development only: outgoing mail is sent to Mailpit
SMTP_HOST='mailpit'
SMTP_PORT=1025

# Used by the HTTP (Hypertext Transfer Protocol) test suite inside the php container
TEST_BASE_URL="${WP_HOME}"
TEST_CONNECT_TO='nginx:80'
TEST_MAILPIT_URL='http://mailpit:8025'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Initial administrator created by bin/install-site
WP_ADMIN_USER='admin'
WP_ADMIN_PASSWORD='admin'
WP_ADMIN_EMAIL='admin@viktoriakupa.test'
