#!/usr/bin/env bash
# Idempotent site setup; run inside the php container.
set -euo pipefail

if ! wp core is-installed 2>/dev/null; then
    wp core install \
        --url="$WP_HOME" \
        --title="Viktória Kupa" \
        --admin_user="$WP_ADMIN_USER" \
        --admin_password="$WP_ADMIN_PASSWORD" \
        --admin_email="$WP_ADMIN_EMAIL" \
        --skip-email
fi

wp language core install hu_HU
wp site switch-language hu_HU
wp language plugin install --all hu_HU
wp option update timezone_string Europe/Budapest
wp option update posts_per_page 15

wp plugin activate advanced-custom-fields wordpress-seo
wp theme activate viktoriakupa

wp option patch update wpseo_titles title-ptarchive-club '%%pt_plural%% %%page%% %%sep%% %%sitename%%'
wp option patch update wpseo_titles social-title-ptarchive-club '%%pt_plural%%'
wp option patch update wpseo_titles title-tax-document_type '%%term_title%% %%page%% %%sep%% %%sitename%%'
wp option patch update wpseo_titles social-title-tax-document_type '%%term_title%%'
wp option patch update wpseo_titles metadesc-post '%%excerpt%%'
wp option patch update wpseo_titles metadesc-page '%%excerpt%%'

page_id() {
    local id
    id=$(wp post list --post_type=page --name="$1" --field=ID)
    echo "${id:-$(wp post create --post_type=page --post_status=publish --post_name="$1" --post_title="$2" --porcelain)}"
}

wp option update show_on_front page
wp option update page_on_front "$(page_id kezdolap 'Kezdőlap')"
wp option update page_for_posts "$(page_id hirek 'Hírek')"

wp rewrite structure '/hirek/%postname%'
wp rewrite flush
