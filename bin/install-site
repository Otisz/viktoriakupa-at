#!/usr/bin/env bash
# Idempotent site setup; run inside the php container.
set -euo pipefail

if ! wp core is-installed 2>/dev/null; then
    wp core install \
        --url="$WP_HOME" \
        --title="Viktória Kupa" \
        --admin_user="$WP_ADMIN_USER" \
        --admin_password="$WP_ADMIN_PASSWORD" \
        --admin_email="$WP_ADMIN_EMAIL" \
        --skip-email
fi

wp language core install hu_HU
wp site switch-language hu_HU
wp language plugin install --all hu_HU
wp option update timezone_string Europe/Budapest
wp option update posts_per_page 15

wp plugin activate advanced-custom-fields wordpress-seo
wp theme activate viktoriakupa

posts_page=$(wp post list --post_type=page --name=hirek --field=ID)
if [ -z "$posts_page" ]; then
    posts_page=$(wp post create --post_type=page --post_status=publish --post_name=hirek --post_title='Hírek' --porcelain)
fi
wp option update page_for_posts "$posts_page"

wp rewrite structure '/hirek/%postname%'
wp rewrite flush
